---
// Reemplazá por tus datos reales
const email = 'mailto:tu-correo@ejemplo.com';
const linkedin = 'https://www.linkedin.com/in/tu-usuario';
---

<section id="contacto" class="section">
  <div class="container">
    <div class="contact">
      <h2 class="contact__title">Contactame</h2>
      <div class="contact__actions">
        <a class="btn btn--light" href={email}>Mail</a>
        <a class="btn btn--ghost" href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
  </div>
</section>

<style>
  .section { padding-block: 110px; }
  .contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding: 72px 24px;
    border-radius: 40px;
    background: var(--grad-h);
    text-align: center;
  }
  .contact__title { font-size: clamp(36px, 5vw, 48px); font-weight: 700; letter-spacing: -0.02em; }
  .contact__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
</style>
