---
const skills = [
  { title: 'Diseñador Web', text: 'Hice varios diseños de paginas web con herramientas como figma' },
  { title: 'Diseñador 3D', text: 'Trabajo con Blender en varias ocaciones para el diseñp de videojuegos' },
  { title: 'Programador', text: 'Programe en varios lenguajes como JS, Python, etc.' },
  { title: 'Poliglota', text: 'Hablo español e ingles con fluides, pero tambien hablo un poco de portugues, hebreo y arabe.' },
];
---

<section id="habilidades" class="section section--tint">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">Habilidades</p>
      <h2 class="section-title">Como me defino</h2>
    </div>

    <div class="grid">
      {skills.map((s) => (
        <article class="skill">
          <span class="skill__bar"></span>
          <h3 class="skill__title">{s.title}</h3>
          <p class="skill__text">{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .skill {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 24px;
  }
  .skill__bar { width: 44px; height: 6px; border-radius: 3px; background: var(--grad-h); }
  .skill__title { font-size: 22px; font-weight: 700; }
  .skill__text { font-size: 15px; line-height: 1.55; color: var(--muted); }

  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
