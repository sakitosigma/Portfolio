---
const studies = [
  {
    school: 'ORT Belgrano',
    image: '/images/ort.png',
    alt: 'Logo de ORT Argentina',
    text: 'Mi educacion secundaria fue en la institucion judia de ORT, a la cual acudi entre 2022-2026, donde me forme en la especialidad de TIC donde desarrolle proyectos con diferentes herramientas de diseño y programacion.',
    reverse: false,
  },
  {
    school: 'Wolfsohn',
    image: '/images/wolfsohn.png',
    alt: 'Logo de Wolfsohn',
    text: 'Mi educacion primaria fue en la institucion judia de Wlfsohn, a la cual acudi entre 2014-2021, donde me forme como persona, aprendi mucho sobre judaismo y conoci muchas personas.',
    reverse: true,
  },
];
---

<section id="estudios" class="section">
  <div class="container studies">
    {studies.map((s) => (
      <div class:list={['study', { 'study--reverse': s.reverse }]}>
        <div class="study__logo">
          <img src={s.image} alt={s.alt} />
        </div>
        <div class="study__card">
          <h3 class="study__title">{s.school}</h3>
          <p class="study__text">{s.text}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .studies { display: grid; gap: 40px; }
  .study { display: flex; align-items: center; gap: 40px; max-width: 932px; }
  .study--reverse { flex-direction: row-reverse; margin-left: auto; }

  .study__logo {
    flex: none;
    width: clamp(150px, 9.7vw, 186px);
    height: clamp(160px, 10.4vw, 200px);
    padding: 8px;
    border-radius: 32px;
    background: linear-gradient(135deg, #1e5ab8, #7be04a);
  }
  .study--reverse .study__logo { background: linear-gradient(135deg, #7be04a, #1e5ab8); }
  .study__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #fff;
    border-radius: 24px;
    padding: 8px;
  }

  .study__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: clamp(160px, 10.4vw, 200px);
    padding: clamp(16px, 1.05vw, 20px);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 24px;
  }
  .study__title, .study__text { margin: 0; }
  .study__title { font-size: 19px; font-weight: 700; }
  .study__text { font-size: 14px; line-height: 1.45; color: var(--muted); }

  @media (max-width: 760px) {
    .study, .study--reverse { flex-direction: column; margin-left: 0; align-items: stretch; }
    .study__logo { width: 172px; align-self: center; }
  }
</style>
