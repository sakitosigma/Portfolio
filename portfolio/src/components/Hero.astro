---
---

<section id="inicio" class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="hero__eyebrow">Estudiante de Bioingenieria</p>
      <h1 class="hero__name">Isaac Cohen<br />Sabban</h1>
      <p class="hero__bio">
        Soy un estudiante recien graduado de la secundaria, estoy empezando mi carrrera
        universitaria de Bioingenieria en la UBA.
      </p>
    </div>

    <div class="framed hero__photo">
      <img src="/images/foto-isaac.png" alt="Foto de Isaac Cohen Sabban" width="424" height="504" />
    </div>
  </div>
</section>

<style>
  .hero { padding-block: 90px 110px; }
  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 440px;
    align-items: center;
    gap: 80px;
  }
  .hero__eyebrow {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--teal);
    margin-bottom: 24px;
  }
  .hero__name {
    font-size: clamp(52px, 7vw, 80px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 24px;
  }
  .hero__bio {
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.25;
    font-weight: 600;
    color: var(--blue);
    max-width: 640px;
  }
  .hero__photo { width: 440px; height: 520px; border-radius: 40px; overflow: hidden; }
  .hero__photo img { width: 100%; height: 100%; object-fit: cover; border-radius: 32px; }

  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; gap: 48px; justify-items: center; text-align: center; }
    .hero__photo { width: min(360px, 100%); height: auto; aspect-ratio: 440 / 520; }
  }
</style>
