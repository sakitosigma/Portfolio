---
interface Props {
  tag: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  href?: string;
}
const { tag, title, description, image, imageAlt, href = '#' } = Astro.props;
---

<article class="card">
  <div class="card__thumb">
    <div class="card__thumb-inner">
      <img src={image} alt={imageAlt} />
    </div>
  </div>
  <div class="card__body">
    <p class="card__tag">{tag}</p>
    <h3 class="card__title">{title}</h3>
    <p class="card__desc">{description}</p>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 24px;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .card:hover { transform: translateY(-4px); border-color: #3a4b70; }
  .card__thumb { background: var(--grad-v); padding: 8px; }
  .card__thumb-inner {
    display: grid;
    place-items: center;
    height: clamp(150px, 11.5vw, 220px);
    background: var(--panel);
  }
  .card__thumb-inner img { max-height: min(180px, 9.4vw); max-width: 80%; object-fit: contain; }
  .card__body { display: flex; flex-direction: column; gap: 8px; padding: clamp(14px, .9vw, 18px) clamp(16px, 1.25vw, 24px) clamp(16px, 1vw, 20px); }
  .card__tag, .card__title, .card__desc { margin: 0; }
  .card__tag { font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--teal); }
  .card__title { font-size: clamp(17px, 1.1vw, 21px); font-weight: 700; line-height: 1.25; }
  .card__desc { font-size: 15px; line-height: 1.55; color: var(--muted); }
</style>
